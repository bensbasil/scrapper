# ==============================================================================
# Local Multi-Container Deployment Environment Configuration
# Copy this template to .env or deploy/.env to override default development values.
#
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# PostgreSQL Database Credentials
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=bi_password
POSTGRES_DB=bi_db
POSTGRES_PORT=5432

# Shared API Authentication Token (Backend & Frontend Proxy)
# Change to a strong random token in production environments.
API_AUTH_TOKEN=dev-secret-token-change-in-prod

# Host Exposed Port Mapping
BACKEND_PORT=8000
FRONTEND_PORT=3000
