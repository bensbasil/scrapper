# ==============================================================================
# Business Opportunity Intelligence Platform — Environment Template
# Copy this template to .env to customize local Docker Compose or standalone runs.
#
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=bi_password
POSTGRES_DB=bi_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bi_user:bi_password@localhost:5432/bi_db

# API Authentication Token (Shared between FastAPI and Next.js proxy)
API_AUTH_TOKEN=dev-secret-token-change-in-prod

# Host Port Mappings
BACKEND_PORT=8000
FRONTEND_PORT=3000
