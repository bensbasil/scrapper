# ==============================================================================
# Business Opportunity Intelligence Platform - Frontend Environment Config
# ==============================================================================


# Internal Backend API Base URL
# Default: http://127.0.0.1:8000 (Local Development)
# Kubernetes: http://bi-api-service:8000
# Docker Compose: http://api:8000
API_INTERNAL_URL="http://127.0.0.1:8000"

# Server-Side API Authentication Token
# Must match the API_AUTH_TOKEN configured on the FastAPI backend server.
# This token is strictly consumed server-side by the Next.js API proxy route handler
# (src/app/api/[[...path]]/route.ts) and is NEVER exposed to client-side bundles or browsers.
API_AUTH_TOKEN="replace_with_server_api_auth_token"
